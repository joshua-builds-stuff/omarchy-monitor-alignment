    # -- state -----------------------------------------------------------

    def reload(self, reset_baseline: bool = False) -> None:
        monitors = load_monitors()
        self.load_failed = monitors is None
        if monitors is None:
            # Keep whatever model we had; Try it and Save stay refused until a
            # reload succeeds.
            if self.monitors:
                self._warn("Could not read monitors from hyprctl — is Hyprland running?")
                return
            monitors = []
        self.monitors = monitors
        if not self.monitors:
            self._warn("No monitors reported by hyprctl — is Hyprland running?")
        self.applied = [m.lua() for m in self.monitors]
        if reset_baseline or not self.baseline:
            self.baseline = [m.lua() for m in self.monitors]
        self.selected = next((m for m in self.monitors if m.enabled),
                             self.monitors[0] if self.monitors else None)
        self._rebuild_selector()
        self._sync_identify(restructure=True)
        self.on_geometry_changed()
        if self.load_failed:
            self._warn("Could not read monitors from hyprctl — is Hyprland running?")

    def _rebuild_selector(self) -> None:
        child = self.selector.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.selector.remove(child)
            child = nxt
        self.buttons: dict[str, Gtk.ToggleButton] = {}
        for mon in self.monitors:
            btn = Gtk.ToggleButton(label=f"{mon.index}  {mon.name}")
            btn.set_tooltip_text(mon.description)
            btn.connect("toggled", self._on_selector, mon)
            self.selector.append(btn)
            self.buttons[mon.name] = btn

    def select(self, mon: Monitor | None) -> None:
        if mon is self.selected:
            return
        self.selected = mon
        self.refresh_controls()
        self.canvas.queue_draw()

    def _on_selector(self, button: Gtk.ToggleButton, mon: Monitor) -> None:
        if self._loading or not button.get_active():
            return
        self.select(mon)

    def on_geometry_changed(self, redraw_only: bool = False) -> None:
        self.canvas.queue_draw()
        self._sync_identify()
        if redraw_only:
            self._sync_position_rows()
            return
        self.refresh_controls()
        self._check()

    def _sync_position_rows(self) -> None:
        mon = self.selected
        if mon is None:
            return
        self._loading = True
        self.x_row.set_value(mon.x)
        self.y_row.set_value(mon.y)
        self._loading = False

    def refresh_controls(self) -> None:
        mon = self.selected
        self._loading = True
        try:
            for name, btn in getattr(self, "buttons", {}).items():
                btn.set_active(mon is not None and name == mon.name)

            if mon is None:
                self.detail.set_title("Display")
                self.detail.set_sensitive(False)
                return

            self.detail.set_sensitive(True)
            self.detail.set_title(f"{mon.index}. {mon.name}")
            self.detail.set_description(mon.description)

            self.enabled_row.set_active(mon.enabled)
            for row in (self.orient_row, self.res_row, self.rate_row,
                        self.scale_row, self.x_row, self.y_row):
                row.set_sensitive(mon.enabled)

            self.orient_row.set_selected(
                ORIENTATION_VALUES.index(mon.transform)
                if mon.transform in ORIENTATION_VALUES else 0)

            resolutions = mon.resolutions()
            self.res_row.set_model(Gtk.StringList.new(
                [r.replace("x", " × ") for r in resolutions]))
            self.res_row.set_selected(
                resolutions.index(mon.mode.res) if mon.mode.res in resolutions else 0)

            rates = mon.rates_for(mon.mode.res)
            self.rate_row.set_model(Gtk.StringList.new([m.rate_label for m in rates]))
            self.rate_row.set_selected(
                rates.index(mon.mode) if mon.mode in rates else 0)

            self._scales = scale_options(mon)
            self.scale_row.set_model(Gtk.StringList.new(
                [f"{scale_label(s)}×" for s in self._scales]))
            nearest = min(range(len(self._scales)),
                          key=lambda i: abs(self._scales[i] - mon.scale))
            self.scale_row.set_selected(nearest)

            self.x_row.set_value(mon.x)
            self.y_row.set_value(mon.y)
        finally:
            self._loading = False
        self._update_summary()

    def _update_summary(self) -> None:
        self.summary_label.set_text(render_block(self.monitors))

    def _check(self) -> None:
        problems = []
        clashes = overlapping(self.monitors)
        if clashes:
            problems.append("Overlapping: " +
                            ", ".join(f"{a} ↔ {b}" for a, b in clashes))
        loose = disconnected(self.monitors)
        if loose:
            problems.append("Not touching any other display: " + ", ".join(loose))
        for mon in active_of(self.monitors):
            if not mon.scale_ok():
                problems.append(f"{mon.name}: scale {scale_label(mon.scale)} is not exact for "
                                f"{mon.mode.label} — Hyprland will adjust it")
        if problems:
            self._warn("  ·  ".join(problems))
        else:
            self.banner.set_revealed(False)
        self._update_summary()

    def _warn(self, text: str) -> None:
        self.banner.set_title(text)
        self.banner.set_revealed(True)

    def _toast(self, text: str) -> None:
        self.toasts.add_toast(Adw.Toast.new(text))

    # -- control handlers ------------------------------------------------

    def _on_layout_kind(self, row, _p) -> None:
        kind = "row" if row.get_selected() == 0 else "column"
        keep = self.align_row.get_selected()
        self.align_row.set_model(Gtk.StringList.new(ALIGN_LABELS[kind]))
        self.align_row.set_selected(keep if keep < 3 else 1)

    def _layout_kind(self) -> str:
        return "row" if self.layout_row.get_selected() == 0 else "column"

    def _on_tidy(self, *_a) -> None:
        kind = self._layout_kind()
        axis = AXES[kind]
        align = ALIGN_KEYS[min(self.align_row.get_selected(), 2)]
        lay_out(order_along(self.monitors, axis), axis, align)
        normalize(self.monitors)
        self.on_geometry_changed()

    def _rotate_all(self, transform: int) -> None:
        for mon in active_of(self.monitors):
            mon.transform = transform
        self._on_tidy()

    def _reorder(self, delta: int) -> None:
        mon = self.selected
        if mon is None or not mon.enabled:
            return
        axis = AXES[self._layout_kind()]
        ordered = order_along(self.monitors, axis)
        if mon not in ordered:
            return
        i = ordered.index(mon)
        j = i + delta
        if not 0 <= j < len(ordered):
            return
        ordered[i], ordered[j] = ordered[j], ordered[i]
        align = ALIGN_KEYS[min(self.align_row.get_selected(), 2)]
        lay_out(ordered, axis, align)
        normalize(self.monitors)
        self.on_geometry_changed()

    def _on_enabled(self, row, _p) -> None:
        if self._loading or self.selected is None:
            return
        if not row.get_active() and len(active_of(self.monitors)) <= 1:
            self._loading = True
            row.set_active(True)
            self._loading = False
            self._toast("At least one display has to stay on")
            return
        self.selected.enabled = row.get_active()
        normalize(self.monitors)
        self._sync_identify(restructure=True)
        self.on_geometry_changed()

    def _on_orientation(self, row, _p) -> None:
        if self._loading or self.selected is None:
            return
        self.selected.transform = ORIENTATION_VALUES[row.get_selected()]
        normalize(self.monitors)
        self.on_geometry_changed()

    def _on_resolution(self, row, _p) -> None:
        if self._loading or self.selected is None:
            return
        mon = self.selected
        resolutions = mon.resolutions()
        idx = row.get_selected()
        if not 0 <= idx < len(resolutions):
            return
        rates = mon.rates_for(resolutions[idx])
        if rates:
            mon.mode = rates[0]
            if not mon.scale_ok():
                mon.scale = mon.nearest_scale()
        normalize(self.monitors)
        self.on_geometry_changed()

    def _on_rate(self, row, _p) -> None:
        if self._loading or self.selected is None:
            return
        mon = self.selected
        rates = mon.rates_for(mon.mode.res)
        idx = row.get_selected()
        if 0 <= idx < len(rates):
            mon.mode = rates[idx]
        self._update_summary()

    def _on_scale(self, row, _p) -> None:
        if self._loading or self.selected is None:
            return
        idx = row.get_selected()
        if 0 <= idx < len(getattr(self, "_scales", [])):
            self.selected.scale = self._scales[idx]
        normalize(self.monitors)
        self.on_geometry_changed()

    def _on_position(self, row, _p) -> None:
        if self._loading or self.selected is None:
            return
        self.selected.x = int(self.x_row.get_value())
        self.selected.y = int(self.y_row.get_value())
        self.on_geometry_changed()

    # -- identify / apply / save ------------------------------------------

    def _on_identify(self, button: Gtk.ToggleButton) -> None:
        if button.get_active():
            self._sync_identify(restructure=True)
            self._toast("Grid stays up while you drag — line the major lines "
                        "up across the bezel to match the offset")
        else:
            self.identify.hide(notify=False)

    def _identify_hidden(self) -> None:
        """The overlay dismissed itself; put the toggle back."""
        if self.identify_button.get_active():
            self.identify_button.set_active(False)

    def _sync_identify(self, restructure: bool = False) -> None:
        """Keep the on-screen grids showing the arrangement being edited."""
        if not self.identify_button.get_active():
            return
        self.identify.pending = [m.lua() for m in self.monitors] != self.applied
        if restructure or not self.identify.visible:
            self.identify.show(self.monitors)
        else:
            self.identify.rebind(self.monitors)

    def _refuse_write(self) -> bool:
        """Warn and return True when there is no trustworthy model to push."""
        if self.load_failed:
            self._warn("Could not read monitors from hyprctl — reload before applying or saving")
            return True
        if not self.monitors:
            self._warn("No monitors loaded — nothing to apply or save")
            return True
        return False

    def _on_apply(self, *_a) -> None:
        if self._refuse_write():
            return
        ok, message = apply_monitors(self.monitors)
        if not ok:
            self._warn(f"Could not apply: {message[:160]}")
            return
        self.banner.set_revealed(False)
        self.applied = [m.lua() for m in self.monitors]
        GLib.timeout_add(400, self._reidentify)
        self._confirm_keep()

    def _reidentify(self) -> bool:
        self._sync_identify(restructure=True)
        return GLib.SOURCE_REMOVE

    def _dismiss_pending(self) -> None:
        """Retire the open Keep/Revert prompt without acting on it."""
        state = self._pending
        if state is None:
            return
        self._pending = None
        if state["source"]:
            GLib.source_remove(state["source"])
            state["source"] = 0
        state["dialog"].force_close()

    def _confirm_keep(self) -> None:
        # Only one prompt at a time: a newer Try it replaces the old prompt, and
        # its revert still goes back to the last kept arrangement.
        self._dismiss_pending()
        dialog = Adw.AlertDialog(heading="Keep this arrangement?")
        dialog.add_response("revert", "Revert")
        dialog.add_response("keep", "Keep")
        dialog.set_response_appearance("keep", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_appearance("revert", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("keep")
        dialog.set_close_response("revert")

        state = {"left": REVERT_SECONDS, "source": 0, "dialog": dialog,
                 "keep": list(self.applied), "revert": list(self.baseline)}
        self._pending = state

        def body(seconds: int) -> str:
            return (f"Reverting to the previous setup in {seconds} s.\n"
                    "Nothing has been written to monitors.lua yet.")

        dialog.set_body(body(state["left"]))

        def tick() -> bool:
            if state is not self._pending:
                state["source"] = 0
                return GLib.SOURCE_REMOVE
            state["left"] -= 1
            if state["left"] <= 0:
                state["source"] = 0
                dialog.close()
                return GLib.SOURCE_REMOVE
            dialog.set_body(body(state["left"]))
            return GLib.SOURCE_CONTINUE

        state["source"] = GLib.timeout_add_seconds(1, tick)

        def responded(_d, response: str) -> None:
            if state is not self._pending:
                return  # superseded by a newer Try it
            self._pending = None
            if state["source"]:
                GLib.source_remove(state["source"])
                state["source"] = 0
            if response == "keep":
                if state.get("rolled_back"):
                    self._warn("The tried layout is no longer on screen — not kept")
                    return
                self.baseline = state["keep"]
                self._toast("Applied. Save to keep it across restarts.")
            else:
                ok, message = hyprctl_eval("\n".join(state["revert"]))
                if not ok:
                    self._warn(f"Could not revert: {message[:160]}")
                    return
                self.reload()
                self._toast("Reverted")

        dialog.connect("response", responded)
        dialog.present(self)

    def _on_save(self, *_a) -> None:
        if self._saving:
            return
        self._saving = True
        try:
            self._save()
        finally:
            self._saving = False

    def _save(self) -> None:
        if self._refuse_write():
            return
        ok, message = apply_monitors(self.monitors)
        if not ok:
            self._warn(f"Could not apply: {message[:160]}")
            return
        ok, message = save_lua(self.monitors)
        if ok:
            self._dismiss_pending()
            self.baseline = [m.lua() for m in self.monitors]
            self.applied = list(self.baseline)
            self.banner.set_revealed(False)
            self._sync_identify(restructure=True)
            self._toast(message)
        else:
            # The failed save restored the previous layout, so the Try it
            # snapshot is no longer on screen and Keep must not adopt it.
            if self._pending is not None:
                self._pending["rolled_back"] = True
            self._dismiss_pending()
            live = load_monitors()
            self.applied = [m.lua() for m in live] if live else []
            self._sync_identify(restructure=True)
            self._warn(message)

    def _on_close(self, *_a) -> bool:
        self._dismiss_pending()
        self.identify.hide()
        return False


