AXES = {"row": "h", "column": "v"}
ALIGN_LABELS = {
    "row": ["Top edges", "Centers", "Bottom edges"],
    "column": ["Left edges", "Centers", "Right edges"],
}
ALIGN_KEYS = ["start", "center", "end"]


def active_of(monitors: list[Monitor]) -> list[Monitor]:
    return [m for m in monitors if m.enabled]


def normalize(monitors: list[Monitor]) -> None:
    """Shift the desktop so its top-left corner sits at 0x0."""
    active = active_of(monitors)
    if not active:
        return
    dx = min(m.x for m in active)
    dy = min(m.y for m in active)
    for mon in monitors:
        mon.x -= dx
        mon.y -= dy


def drag_moved(origin: tuple[int, int], position: tuple[int, int]) -> bool:
    """Whether a finished canvas gesture moved its tile; a plain click does not."""
    return tuple(position) != tuple(origin)


def order_along(monitors: list[Monitor], axis: str) -> list[Monitor]:
    """Enabled monitors in their current visual order along an axis."""
    active = active_of(monitors)
    if axis == "h":
        return sorted(active, key=lambda m: (m.x, m.y, m.name))
    return sorted(active, key=lambda m: (m.y, m.x, m.name))


def lay_out(ordered: list[Monitor], axis: str, align: str) -> None:
    """Pack monitors edge to edge along `axis`, aligned on the cross axis."""
    if not ordered:
        return
    cross = max((m.logical[1] if axis == "h" else m.logical[0]) for m in ordered)
    cursor = 0
    for mon in ordered:
        w, h = mon.logical
        if axis == "h":
            mon.x = cursor
            cursor += w
            slack = cross - h
        else:
            mon.y = cursor
            cursor += h
            slack = cross - w
        offset = 0 if align == "start" else (slack // 2 if align == "center" else slack)
        if axis == "h":
            mon.y = offset
        else:
            mon.x = offset


def overlapping(monitors: list[Monitor]) -> list[tuple[str, str]]:
    hits = []
    active = active_of(monitors)
    for i, a in enumerate(active):
        ax, ay, aw, ah = a.rect
        for b in active[i + 1:]:
            bx, by, bw, bh = b.rect
            if ax < bx + bw and bx < ax + aw and ay < by + bh and by < ay + ah:
                hits.append((a.name, b.name))
    return hits


def disconnected(monitors: list[Monitor]) -> list[str]:
    """Monitors that share no edge with any other monitor."""
    active = active_of(monitors)
    if len(active) < 2:
        return []
    loose = []
    for a in active:
        ax, ay, aw, ah = a.rect
        touches = False
        for b in active:
            if b is a:
                continue
            bx, by, bw, bh = b.rect
            h_touch = (ax + aw == bx or bx + bw == ax) and ay < by + bh and by < ay + ah
            v_touch = (ay + ah == by or by + bh == ay) and ax < bx + bw and bx < ax + aw
            if h_touch or v_touch:
                touches = True
                break
        if not touches:
            loose.append(a.name)
    return loose


