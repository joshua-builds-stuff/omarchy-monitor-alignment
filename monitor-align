ORIENTATIONS = [
    (0, "Landscape"),
    (1, "Portrait — rotated 90°"),
    (3, "Portrait — rotated 270°"),
    (2, "Landscape — upside down"),
    (4, "Landscape — mirrored"),
    (5, "Portrait — 90° mirrored"),
    (7, "Portrait — 270° mirrored"),
    (6, "Landscape — 180° mirrored"),
]
ORIENTATION_VALUES = [t for t, _ in ORIENTATIONS]

COMMON_SCALES = [1.0, 1.25, 1.3333, 1.5, 1.6, 1.75, 2.0, 2.25, 2.5, 3.0]


def scale_options(mon: Monitor) -> list[float]:
    valid = mon.valid_scales()
    opts: list[float] = []
    for want in COMMON_SCALES:
        if not valid:
            break
        near = min(valid, key=lambda v: abs(v - want))
        if abs(near - want) < 0.01:
            opts.append(near)
    if not any(abs(mon.scale - o) < 1e-3 for o in opts):
        opts.append(mon.scale)
    return sorted(set(opts))


