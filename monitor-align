def rounded_rect(cr, x, y, w, h, r) -> None:
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text_at(cr, text, x, y, size, rgb, alpha=1.0, bold=False,
            anchor="c", mono=False):
    layout = PangoCairo.create_layout(cr)
    family = "Monospace" if mono else "Sans"
    weight = "Bold " if bold else ""
    layout.set_font_description(
        Pango.FontDescription.from_string(f"{family} {weight}{size}"))
    layout.set_text(text, -1)
    tw, th = layout.get_pixel_size()
    if anchor in ("c", "n", "s"):
        tx = x - tw / 2
    elif anchor in ("e", "ne", "se"):
        tx = x - tw
    else:
        tx = x
    if anchor in ("c", "e", "w"):
        ty = y - th / 2
    elif anchor in ("s", "se", "sw"):
        ty = y - th
    else:
        ty = y
    cr.set_source_rgba(*rgb, alpha)
    cr.move_to(tx, ty)
    PangoCairo.show_layout(cr, layout)
    return tw, th


def chip(cr, text, x, y, size, fg, bg, anchor="c", mono=False, pad=6):
    """Text on a rounded plate, so labels stay readable over any wallpaper."""
    layout = PangoCairo.create_layout(cr)
    family = "Monospace" if mono else "Sans"
    layout.set_font_description(
        Pango.FontDescription.from_string(f"{family} Bold {size}"))
    layout.set_text(text, -1)
    tw, th = layout.get_pixel_size()
    bw, bh = tw + pad * 2, th + pad
    bx = x - bw / 2 if anchor in ("c", "n", "s") else (x - bw if anchor in ("e", "ne", "se") else x)
    by = y - bh / 2 if anchor in ("c", "e", "w") else (y - bh if anchor in ("s", "se", "sw") else y)
    cr.set_source_rgba(*bg, 0.82)
    rounded_rect(cr, bx, by, bw, bh, 5)
    cr.fill()
    cr.set_source_rgba(*fg, 1.0)
    cr.move_to(bx + pad, by + bh / 2 - th / 2)
    PangoCairo.show_layout(cr, layout)
    return bw, bh


