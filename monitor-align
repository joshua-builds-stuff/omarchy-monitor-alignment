def hyprctl_json(args: list[str]):
    """Parsed JSON from `hyprctl -j`, or None when the read failed."""
    try:
        out = subprocess.run(["hyprctl", "-j"] + args, capture_output=True,
                             text=True, timeout=5)
        if out.returncode != 0:
            return None
        return json.loads(out.stdout)
    except Exception:
        return None


def hyprctl_eval(chunk: str) -> tuple[bool, str]:
    """Run a Lua chunk inside Hyprland.

    Omarchy drives Hyprland through its Lua config parser, which refuses
    `hyprctl keyword` outright ("keyword can't work with non-legacy parsers.
    Use eval."), so live changes have to go through `hyprctl eval`. It answers
    a bare "ok" on success; anything else is a failure, including the refusal
    above, which exits 0 and never says "error".
    """
    if not chunk.strip():
        return True, ""
    try:
        out = subprocess.run(["hyprctl", "eval", chunk], capture_output=True,
                             text=True, timeout=10)
    except Exception as exc:
        return False, str(exc)
    text = (out.stdout + out.stderr).strip()
    return out.returncode == 0 and text.lower().startswith("ok"), text


def apply_monitors(monitors: list[Monitor]) -> tuple[bool, str]:
    """Push the whole arrangement to Hyprland in one chunk."""
    if not monitors:
        return False, "no monitors to apply"
    return hyprctl_eval("\n".join(m.lua() for m in monitors))


def hyprctl(*args: str) -> str:
    try:
        out = subprocess.run(["hyprctl", *args], capture_output=True,
                             text=True, timeout=10)
        return (out.stdout + out.stderr).strip()
    except Exception as exc:
        return str(exc)


