# Entry point
# --------------------------------------------------------------------------


class Application(Adw.Application):

    def __init__(self) -> None:
        super().__init__(application_id=APP_ID)

    def do_activate(self) -> None:
        window = self.props.active_window or MonitorAlign(self)
        window.present()


def run_identify_only(seconds: int) -> int:
    """`monitor-align --identify` - just flash the grid, no window."""
    app = Adw.Application(application_id=APP_ID + ".Identify")

    def activate(_a) -> None:
        overlay = IdentifyOverlay(Palette())
        overlay.show(load_monitors() or [], seconds)
        if not overlay.visible:
            app.quit()
            return
        GLib.timeout_add_seconds(seconds + 1, lambda: (app.quit(), GLib.SOURCE_REMOVE)[1])
        app.hold()

    app.connect("activate", activate)
    return app.run([])


def main(argv: list[str]) -> int:
    if "--version" in argv:
        print(f"monitor-align {VERSION}")
        return 0
    if not os.environ.get("WAYLAND_DISPLAY"):
        print("monitor-align needs a Wayland session (Hyprland).", file=sys.stderr)
        return 1
    if not shutil.which("hyprctl"):
        print("hyprctl not found — this tool targets Hyprland.", file=sys.stderr)
        return 1
    if "--identify" in argv:
        rest = [a for a in argv[argv.index("--identify") + 1:] if a.isdigit()]
        return run_identify_only(int(rest[0]) if rest else IDENTIFY_SECONDS)
    return Application().run([])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
