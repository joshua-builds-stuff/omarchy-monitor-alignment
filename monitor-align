EDITED_KEYS = {"output", "mode", "position", "scale", "transform", "disabled", "mirror"}


def lua_string(value: str) -> str:
    """Return a Lua double-quoted string containing exactly ``value``.

    Monitor metadata comes from the compositor and can ultimately reach the
    Lua configuration evaluator.  Escape syntax characters, source line
    separators, and control/format bytes instead of trusting that metadata to
    already match Hyprland's connector-name grammar.
    """
    escaped: list[str] = []
    for char in str(value):
        if char == "\\":
            escaped.append("\\\\")
        elif char == '"':
            escaped.append('\\"')
        elif char == "\n":
            escaped.append("\\n")
        elif char == "\r":
            escaped.append("\\r")
        elif char == "\t":
            escaped.append("\\t")
        elif char in ("\u2028", "\u2029") or unicodedata.category(char).startswith("C"):
            escaped.extend(
                f"\\{byte:03d}" for byte in char.encode("utf-8", "surrogatepass"))
        else:
            escaped.append(char)
    return '"' + "".join(escaped) + '"'


@dataclass(frozen=True)
class Mode:
    w: int
    h: int
    rate: float

    @property
    def res(self) -> str:
        return f"{self.w}x{self.h}"

    @property
    def label(self) -> str:
        return f"{self.w}×{self.h}"

    @property
    def rate_label(self) -> str:
        return f"{self.rate:.2f} Hz".replace(".00 ", " ")

    @property
    def hypr(self) -> str:
        return f"{self.w}x{self.h}@{self.rate:.2f}"


def parse_mode(text: str) -> Mode | None:
    # "2560x1440@143.86Hz"
    try:
        geom, _, rate = text.partition("@")
        w, _, h = geom.partition("x")
        return Mode(int(w), int(h), float(rate.rstrip("Hz")))
    except Exception:
        return None


SCALE_STEPS = 120  # Hyprland only honours scales on a 1/120 lattice


def scale_fits(mode: Mode, scale: float) -> bool:
    """True when `scale` is on the lattice and divides the mode exactly."""
    steps = scale * SCALE_STEPS
    if scale <= 0 or abs(steps - round(steps)) > 1e-6:
        return False
    return all(abs(side / scale - round(side / scale)) < 1e-4
               for side in (mode.w, mode.h))


def valid_scales_for(mode: Mode) -> list[float]:
    """Exact k/120 scales between 0.5 and 3 that give an integer logical size."""
    return [step / SCALE_STEPS for step in range(60, 361)
            if scale_fits(mode, step / SCALE_STEPS)]


def snap_scale(mode: Mode, reported: float) -> float:
    """Recover the real scale from hyprctl's two-decimal rendering of it.

    `hyprctl -j monitors` prints the scale with `{:.2f}`, so 4/3 arrives as
    1.33 and 5/3 as 1.67. Pick the valid lattice scale that could have been
    printed that way; failing that, the nearest 1/120 step.
    """
    if reported <= 0:
        return 1.0
    near = [s for s in valid_scales_for(mode) if abs(s - reported) <= 0.0051]
    if near:
        return min(near, key=lambda s: abs(s - reported))
    return max(1, round(reported * SCALE_STEPS)) / SCALE_STEPS


def format_scale(scale: float) -> str:
    """Enough digits for Hyprland to land back on the same 1/120 step."""
    return f"{scale:.10g}"


def scale_label(scale: float) -> str:
    return f"{round(scale, 4):g}"


@dataclass
class Monitor:
    name: str
    description: str
    modes: list[Mode]
    mode: Mode
    scale: float
    transform: int
    x: int
    y: int
    enabled: bool
    index: int = 0
    mirror: str = ""
    # Keys of this output's existing hl.monitor rule that the editor does not
    # edit (bitdepth, cm, vrr, ...), as raw Lua values, written back verbatim.
    extra: dict[str, str] = field(default_factory=dict)

    @property
    def rotated(self) -> bool:
        return self.transform in (1, 3, 5, 7)

    @property
    def logical(self) -> tuple[int, int]:
        w = int(round(self.mode.w / self.scale))
        h = int(round(self.mode.h / self.scale))
        return (h, w) if self.rotated else (w, h)

    @property
    def rect(self) -> tuple[int, int, int, int]:
        w, h = self.logical
        return (self.x, self.y, w, h)

    def resolutions(self) -> list[str]:
        seen: list[str] = []
        for mode in self.modes:
            if mode.res not in seen:
                seen.append(mode.res)
        return seen

    def rates_for(self, res: str) -> list[Mode]:
        return sorted((m for m in self.modes if m.res == res),
                      key=lambda m: -m.rate)

    def scale_ok(self) -> bool:
        return scale_fits(self.mode, self.scale)

    def valid_scales(self) -> list[float]:
        return valid_scales_for(self.mode)

    def nearest_scale(self) -> float:
        options = self.valid_scales()
        if not options:
            return 1.0
        return min(options, key=lambda s: abs(s - self.scale))

    def lua(self) -> str:
        if not self.enabled:
            # Keep the geometry so the display returns where it was when it
            # is enabled again, and a reload can recover its position.
            # Also keep mirror / unedited keys (#32) via passthrough().
            return (f"hl.monitor({{ output = {lua_string(self.name)}, "
                    f'mode = "{self.mode.hypr}", '
                    f'position = "{self.x}x{self.y}", '
                    f'scale = {format_scale(self.scale)}, '
                    f'transform = {self.transform}, '
                    f'disabled = true{self.passthrough()} }})')
        return (f"hl.monitor({{ output = {lua_string(self.name)}, "
                f'mode = "{self.mode.hypr}", '
                f'position = "{self.x}x{self.y}", '
                f'scale = {format_scale(self.scale)}, '
                f'transform = {self.transform}{self.passthrough()} }})')

    def passthrough(self) -> str:
        """Mirror and preserved keys, each prefixed with ", "."""
        parts = []
        if self.mirror:
            parts.append(f"mirror = {lua_string(self.mirror)}")
        parts.extend(f"{key} = {value}" for key, value in self.extra.items()
                     if key not in EDITED_KEYS)
        return "".join(f", {part}" for part in parts)


def pick_mode(modes: list[Mode], w: int, h: int, rate: float) -> Mode:
    candidates = [m for m in modes if m.w == w and m.h == h]
    if not candidates:
        candidates = [m for m in modes if m.w == h and m.h == w]
    if not candidates:
        return Mode(max(w, 1), max(h, 1), rate or 60.0)
    return min(candidates, key=lambda m: abs(m.rate - rate))


def saved_position(text: str, name: str) -> tuple[int, int] | None:
    """The position the last hl.monitor rule for `name` in `text` sets, if any."""
    output = f"output = {lua_string(name)}"
    found = None
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("hl.monitor(") or not (
                output + "," in line or output + " " in line):
            continue
        match = re.search(r'position\s*=\s*"(-?\d+)x(-?\d+)"', line)
        found = (int(match.group(1)), int(match.group(2))) if match else None
    return found


def lua_table_fields(text: str, start: int) -> tuple[list[tuple[str, str]], int]:
    """Top-level `key = value` pairs of the Lua table opening at text[start].

    Values are kept as raw source. Returns the pairs and the index just past
    the closing brace (or len(text) when the table is unterminated).
    """
    depth = 0
    quote = ""
    parts: list[str] = []
    current: list[str] = []
    i = start
    while i < len(text):
        char = text[i]
        if quote:
            current.append(char)
            if char == "\\" and i + 1 < len(text):
                current.append(text[i + 1])
                i += 1
            elif char == quote:
                quote = ""
        elif char in ("'", '"'):
            quote = char
            current.append(char)
        elif text.startswith("--", i):
            end = text.find("\n", i)
            i = len(text) if end < 0 else end
            continue
        elif char in "{([":
            depth += 1
            if depth > 1:
                current.append(char)
        elif char in "})]":
            depth -= 1
            if depth == 0:
                parts.append("".join(current))
                i += 1
                break
            current.append(char)
        elif char in ",;" and depth == 1:
            parts.append("".join(current))
            current = []
        else:
            current.append(char)
        i += 1
    pairs = []
    for part in parts:
        key, eq, value = part.partition("=")
        key, value = key.strip(), value.strip()
        if eq and key.isidentifier() and value:
            pairs.append((key, value))
    return pairs, i


def existing_rule_keys(text: str, name: str) -> dict[str, str]:
    """Keys of the last hl.monitor rule for `name` in `text`, as raw Lua values."""
    found: dict[str, str] = {}
    pos = 0
    while True:
        at = text.find("hl.monitor(", pos)
        if at < 0:
            return found
        line_start = text.rfind("\n", 0, at) + 1
        brace = text.find("{", at)
        if "--" in text[line_start:at] or brace < 0:
            pos = at + 1
            continue
        pairs, pos = lua_table_fields(text, brace)
        rule = dict(pairs)
        output = rule.get("output", "")
        if output == lua_string(name) or (
                len(output) >= 2 and output[0] == output[-1] and output[0] in "'\""
                and "\\" not in output and output[1:-1] == name):
            found = rule


def read_monitors_lua() -> str:
    try:
        with open(MONITORS_LUA, "r") as handle:
            return handle.read()
    except OSError:
        return ""


def load_monitors() -> list[Monitor] | None:
    """The desk as hyprctl reports it, or None when hyprctl could not be read."""
    entries = hyprctl_json(["monitors", "all"])
    if not isinstance(entries, list):
        return None
    saved_text = read_monitors_lua()
    monitors: list[Monitor] = []
    for entry in entries:
        modes = [m for m in (parse_mode(s) for s in entry.get("availableModes", [])) if m]
        modes.sort(key=lambda m: (-m.w * m.h, -m.rate))
        width = int(entry.get("width") or 0)
        height = int(entry.get("height") or 0)
        rate = float(entry.get("refreshRate") or 60.0)
        if width and height:
            mode = pick_mode(modes, width, height, rate)
        elif modes:
            mode = modes[0]
        else:
            mode = Mode(1920, 1080, 60.0)
        if not modes:
            modes = [mode]
        scale = snap_scale(mode, float(entry.get("scale") or 1.0))
        name = entry.get("name", "?")
        enabled = not entry.get("disabled", False)
        x = int(entry.get("x") or 0)
        y = int(entry.get("y") or 0)
        if not enabled and x == 0 and y == 0:
            # A disabled output reports 0x0; its saved rule knows where it sat.
            x, y = saved_position(saved_text, name) or (x, y)
        mirror = str(entry.get("mirrorOf") or "none")
        extra = {key: value
                 for key, value in existing_rule_keys(saved_text, name).items()
                 if key not in EDITED_KEYS}
        monitors.append(Monitor(
            name=name,
            description=entry.get("description", ""),
            modes=modes,
            mode=mode,
            scale=scale,
            transform=int(entry.get("transform") or 0),
            x=x,
            y=y,
            enabled=enabled,
            mirror="" if mirror == "none" else mirror,
            extra=extra,
        ))
    # Number them left to right, top to bottom, so the badges the identify
    # overlay paints on the real screens read 1, 2, 3 across the desk.
    monitors.sort(key=lambda m: (m.x, m.y, m.name))
    for i, mon in enumerate(monitors, start=1):
        mon.index = i
    return monitors


