# Identify overlays - full-screen alignment grid on every physical display
# --------------------------------------------------------------------------


def desktop_grid(monitors: list[Monitor]) -> tuple[int, int]:
    """One (minor, major) grid spacing shared by every screen.

    The grid is drawn in global desktop coordinates, so it only proves
    alignment if all displays use the same step - a line at y=500 has to
    exist on both sides of a bezel to be worth comparing. The step is sized
    off the smallest edge in the setup so the densest screen stays readable.
    """
    sides = [side for mon in active_of(monitors) for side in mon.logical]
    if not sides:
        return 100, 500
    smallest = min(sides)
    for minor, major in ((25, 100), (50, 250), (100, 500), (200, 1000)):
        if smallest / minor <= 16:
            return minor, major
    return 250, 1000


class IdentifyOverlay:
    """Layer-shell windows drawing a coordinate grid on each real screen.

    The overlays stay up for as long as the Identify toggle is on and redraw
    from the *pending* arrangement, so dragging a display in the window moves
    its grid on the glass. That is the point of the thing: you line the major
    lines up across the bezel, and the offset is right.
    """

    def __init__(self, palette: Palette, on_hidden=None) -> None:
        self.palette = palette
        self.on_hidden = on_hidden
        self.windows: list[Gtk.Window] = []
        self.areas: list[tuple[Gtk.DrawingArea, str]] = []
        self.timeout: int | None = None
        self.pending = False

    @property
    def visible(self) -> bool:
        return bool(self.windows)

    def hide(self, notify: bool = True) -> None:
        had = bool(self.windows)
        if self.timeout:
            GLib.source_remove(self.timeout)
            self.timeout = None
        for win in self.windows:
            win.destroy()
        self.windows = []
        self.areas = []
        if had and notify and self.on_hidden is not None:
            self.on_hidden()

    def show(self, monitors: list[Monitor], seconds: int = 0) -> None:
        """Put a grid on every screen. seconds <= 0 keeps them up."""
        self.hide(notify=False)
        by_name = {m.name: m for m in monitors}
        display = Gdk.Display.get_default()
        if display is None:
            return
        gdk_monitors = display.get_monitors()
        for i in range(gdk_monitors.get_n_items()):
            gdk_mon = gdk_monitors.get_item(i)
            name = gdk_mon.get_connector() or ""
            mon = by_name.get(name)
            if mon is None or not mon.enabled:
                continue
            self.windows.append(self._make_window(gdk_mon, mon, monitors))
        if self.windows and seconds > 0:
            self.timeout = GLib.timeout_add_seconds(seconds, self._expire)

    def refresh(self) -> None:
        """Repaint from whatever the Monitor objects now say."""
        for area, _ in self.areas:
            area.queue_draw()
        for win in self.windows:
            self._click_through(win)

    def rebind(self, monitors: list[Monitor]) -> None:
        """Point the overlays at a fresh set of Monitor objects, then repaint."""
        by_name = {m.name: m for m in monitors}
        if any(name not in by_name or not by_name[name].enabled
               for _, name in self.areas):
            self.show(monitors)
            return
        for area, name in self.areas:
            area.set_draw_func(self._draw, (by_name[name], monitors))
        self.refresh()

    def _expire(self) -> bool:
        self.timeout = None
        self.hide()
        return GLib.SOURCE_REMOVE

    def _make_window(self, gdk_mon, mon: Monitor, all_mons: list[Monitor]) -> Gtk.Window:
        win = Gtk.Window()
        win.add_css_class("identify")
        LayerShell.init_for_window(win)
        LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
        LayerShell.set_monitor(win, gdk_mon)
        LayerShell.set_namespace(win, "monitor-align-identify")
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM,
                     LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(win, edge, True)
        LayerShell.set_exclusive_zone(win, -1)

        area = Gtk.DrawingArea()
        area.set_draw_func(self._draw, (mon, all_mons))
        win.set_child(area)
        self.areas.append((area, mon.name))

        # Escape hatch: the overlays are meant to be click-through, but if the
        # compositor does route a click here, dismiss rather than trap the user
        # under a full-screen surface they cannot get out of.
        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: self.hide())
        area.add_controller(click)

        win.connect("map", self._click_through)
        win.present()
        return win

    def _click_through(self, win: Gtk.Window) -> None:
        """Pass pointer events through to whatever is underneath.

        Re-applied on every refresh: GTK resets the input region when the
        surface is reconfigured, and a persistent overlay that swallows clicks
        would make the window behind it undraggable.
        """
        def apply() -> bool:
            try:
                surface = win.get_surface()
                if surface is not None:
                    surface.set_input_region(cairo.Region())
            except Exception:
                pass
            return GLib.SOURCE_REMOVE
        GLib.idle_add(apply)

    def _draw(self, area, cr, width, height, data) -> None:
        mon, all_mons = data
        pal = self.palette
        lw, lh = mon.logical
        # Widget pixels -> logical desktop pixels (1:1 unless GTK scales us).
        sx = lw / width if width else 1.0
        sy = lh / height if height else 1.0
        ox, oy = mon.x, mon.y

        def px(gx: float) -> float:
            return (gx - ox) / sx

        def py(gy: float) -> float:
            return (gy - oy) / sy

        # Dim backdrop so the grid reads over any wallpaper.
        cr.set_source_rgba(*pal.darker_background, 0.62)
        cr.paint()

        minor, major = desktop_grid(all_mons)

        def lines(step, start, span):
            first = math.ceil(start / step) * step
            value = first
            while value <= start + span:
                yield value
                value += step

        # Minor grid.
        cr.set_line_width(1.0)
        cr.set_source_rgba(*pal.accent, 0.16)
        for gx in lines(minor, ox, lw):
            cr.move_to(round(px(gx)) + 0.5, 0)
            cr.line_to(round(px(gx)) + 0.5, height)
        for gy in lines(minor, oy, lh):
            cr.move_to(0, round(py(gy)) + 0.5)
            cr.line_to(width, round(py(gy)) + 0.5)
        cr.stroke()

        # Major grid, labelled with global desktop coordinates. Two monitors
        # are aligned when their major lines meet across the bezel.
        cr.set_line_width(1.5)
        cr.set_source_rgba(*pal.accent, 0.45)
        for gx in lines(major, ox, lw):
            cr.move_to(round(px(gx)) + 0.5, 0)
            cr.line_to(round(px(gx)) + 0.5, height)
        for gy in lines(major, oy, lh):
            cr.move_to(0, round(py(gy)) + 0.5)
            cr.line_to(width, round(py(gy)) + 0.5)
        cr.stroke()

        for gx in lines(major, ox, lw):
            if px(gx) < 34 or px(gx) > width - 34:
                continue
            text_at(cr, str(gx), px(gx) + 5, 6, 9, pal.accent, 0.8,
                    anchor="nw", mono=True)
        for gy in lines(major, oy, lh):
            if py(gy) < 20 or py(gy) > height - 20:
                continue
            text_at(cr, str(gy), 6, py(gy) + 4, 9, pal.accent, 0.8,
                    anchor="nw", mono=True)

        # Screen edge, centre crosshair.
        cr.set_line_width(4.0)
        cr.set_source_rgba(*pal.accent, 0.9)
        cr.rectangle(2, 2, width - 4, height - 4)
        cr.stroke()

        cx, cy = width / 2, height / 2
        cr.set_line_width(1.0)
        cr.set_source_rgba(*pal.accent, 0.55)
        cr.move_to(cx + 0.5, 0); cr.line_to(cx + 0.5, height)
        cr.move_to(0, cy + 0.5); cr.line_to(width, cy + 0.5)
        cr.stroke()

        # Identity plate.
        badge = min(width, height) * 0.22
        cr.set_source_rgba(*pal.accent, 0.92)
        cr.arc(cx, cy - badge * 0.15, badge / 2, 0, 2 * math.pi)
        cr.fill()
        number_color = pal.darker_background if pal.dark else pal.background
        text_at(cr, str(mon.index), cx, cy - badge * 0.15, int(badge * 0.5),
                number_color, 1.0, bold=True)

        below = cy + badge * 0.5
        text_at(cr, mon.name, cx, below, 26, pal.bright_foreground, 1.0, bold=True,
                anchor="n")
        detail = (f"{mon.mode.label} @ {mon.mode.rate:.2f} Hz   ·   "
                  f"scale {scale_label(mon.scale)}   ·   {TRANSFORMS[mon.transform][1]}")
        text_at(cr, detail, cx, below + 38, 12, pal.foreground, 0.95, anchor="n")
        text_at(cr, mon.description, cx, below + 60, 10, pal.foreground,
                0.75, anchor="n")
        text_at(cr, f"origin {mon.x},{mon.y}   size {lw}×{lh}",
                cx, below + 80, 11, pal.accent, 0.95, anchor="n", mono=True)

        # While the arrangement is unapplied the grid shows where this screen
        # *would* sit, over a panel the compositor has not moved yet. Say so.
        if self.pending:
            chip(cr, "PREVIEW — press “Try it” to move the screens",
                 cx, 42, 12, pal.darker_background, pal.accent, anchor="n")

        # Corner coordinates - the numbers to compare between two screens.
        fg = pal.bright_foreground
        bg = pal.darker_background
        chip(cr, f"{ox},{oy}", 14, 14, 10, fg, bg, anchor="nw", mono=True)
        chip(cr, f"{ox + lw},{oy}", width - 14, 14, 10, fg, bg, anchor="ne", mono=True)
        chip(cr, f"{ox},{oy + lh}", 14, height - 14, 10, fg, bg, anchor="sw", mono=True)
        chip(cr, f"{ox + lw},{oy + lh}", width - 14, height - 14, 10, fg, bg,
             anchor="se", mono=True)

        # Neighbour hints on the edges that actually touch another screen.
        for other in active_of(all_mons):
            if other is mon or other.name == mon.name:
                continue
            oxx, oyy, oww, ohh = other.rect
            if oxx + oww == ox and oyy < oy + lh and oy < oyy + ohh:
                y0 = max(oy, oyy); y1 = min(oy + lh, oyy + ohh)
                cr.set_source_rgba(*pal.green, 0.85)
                cr.set_line_width(6)
                cr.move_to(3, py(y0)); cr.line_to(3, py(y1)); cr.stroke()
                chip(cr, f"◀ {other.index} {other.name}", 16, py((y0 + y1) / 2),
                     11, fg, bg, anchor="w")
            if ox + lw == oxx and oyy < oy + lh and oy < oyy + ohh:
                y0 = max(oy, oyy); y1 = min(oy + lh, oyy + ohh)
                cr.set_source_rgba(*pal.green, 0.85)
                cr.set_line_width(6)
                cr.move_to(width - 3, py(y0)); cr.line_to(width - 3, py(y1)); cr.stroke()
                chip(cr, f"{other.name} {other.index} ▶", width - 16,
                     py((y0 + y1) / 2), 11, fg, bg, anchor="e")
            if oyy + ohh == oy and oxx < ox + lw and ox < oxx + oww:
                x0 = max(ox, oxx); x1 = min(ox + lw, oxx + oww)
                cr.set_source_rgba(*pal.green, 0.85)
                cr.set_line_width(6)
                cr.move_to(px(x0), 3); cr.line_to(px(x1), 3); cr.stroke()
                chip(cr, f"▲ {other.index} {other.name}", px((x0 + x1) / 2), 16,
                     11, fg, bg, anchor="n")
            if oy + lh == oyy and oxx < ox + lw and ox < oxx + oww:
                x0 = max(ox, oxx); x1 = min(ox + lw, oxx + oww)
                cr.set_source_rgba(*pal.green, 0.85)
                cr.set_line_width(6)
                cr.move_to(px(x0), height - 3); cr.line_to(px(x1), height - 3); cr.stroke()
                chip(cr, f"▼ {other.index} {other.name}", px((x0 + x1) / 2),
                     height - 16, 11, fg, bg, anchor="s")


# --------------------------------------------------------------------------
# Arrangement canvas
# --------------------------------------------------------------------------


class Canvas(Gtk.DrawingArea):
    """Scaled top-down view of the desktop; monitors are draggable tiles."""

    def __init__(self, app: "MonitorAlign") -> None:
        super().__init__()
        self.app = app
        self.pal = app.pal
        self.zoom = 1.0
        self.offset = (0.0, 0.0)
        self.drag_target: Monitor | None = None
        self.drag_origin = (0, 0)
        self.drag_view = (1.0, (0.0, 0.0))
        self.guides: list[tuple[str, float]] = []

        self.set_hexpand(True)
        self.set_vexpand(True)
        self.set_size_request(520, 340)
        self.add_css_class("mon-canvas")
        self.set_draw_func(self._draw)

        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._drag_begin)
        drag.connect("drag-update", self._drag_update)
        drag.connect("drag-end", self._drag_end)
        self.add_controller(drag)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._motion)
        self.add_controller(motion)

    # -- projection ------------------------------------------------------

    def _fit(self, width: int, height: int) -> None:
        mons = self.app.monitors
        if not mons:
            self.zoom, self.offset = 1.0, (0.0, 0.0)
            return
        pad = 36
        xs0 = min(m.x for m in mons)
        ys0 = min(m.y for m in mons)
        xs1 = max(m.x + m.logical[0] for m in mons)
        ys1 = max(m.y + m.logical[1] for m in mons)
        span_w = max(xs1 - xs0, 1)
        span_h = max(ys1 - ys0, 1)
        self.zoom = min((width - pad * 2) / span_w, (height - pad * 2) / span_h)
        self.offset = (
            (width - span_w * self.zoom) / 2 - xs0 * self.zoom,
            (height - span_h * self.zoom) / 2 - ys0 * self.zoom,
        )

    def _view(self, width: int, height: int) -> None:
        """Refit, except mid-drag where the drag-begin projection is kept."""
        if self.drag_target is None:
            self._fit(width, height)
        else:
            self.zoom, self.offset = self.drag_view

    def to_widget(self, x: float, y: float) -> tuple[float, float]:
        return (x * self.zoom + self.offset[0], y * self.zoom + self.offset[1])

    def to_desktop(self, x: float, y: float) -> tuple[float, float]:
        return ((x - self.offset[0]) / self.zoom, (y - self.offset[1]) / self.zoom)

    def monitor_at(self, wx: float, wy: float) -> Monitor | None:
        dx, dy = self.to_desktop(wx, wy)
        for mon in reversed(self.app.monitors):
            mx, my, mw, mh = mon.rect
            if mx <= dx <= mx + mw and my <= dy <= my + mh:
                return mon
        return None

    # -- interaction -----------------------------------------------------

    def _motion(self, _c, x, y) -> None:
        hit = self.monitor_at(x, y)
        self.set_cursor(Gdk.Cursor.new_from_name("grab" if hit else "default", None))

    def _drag_begin(self, _g, x, y) -> None:
        mon = self.monitor_at(x, y)
        self.drag_target = mon
        if mon is None:
            return
        self.drag_origin = (mon.x, mon.y)
        self.drag_view = (self.zoom, self.offset)
        self.app.select(mon)
        self.set_cursor(Gdk.Cursor.new_from_name("grabbing", None))

    def _drag_update(self, _g, dx, dy) -> None:
        mon = self.drag_target
        if mon is None:
            return
        zoom = self.drag_view[0]
        nx = self.drag_origin[0] + dx / zoom
        ny = self.drag_origin[1] + dy / zoom
        mon.x, mon.y, self.guides = self._snap(mon, nx, ny)
        self.app.on_geometry_changed(redraw_only=True)

    def _drag_end(self, _g, dx, dy) -> None:
        mon = self.drag_target
        if mon is None:
            return
        if dx or dy or drag_moved(self.drag_origin, (mon.x, mon.y)):
            self._drag_update(_g, dx, dy)
        self.drag_target = None
        self.guides = []
        # A click only selects; keep origins typed into Position X/Y.
        if drag_moved(self.drag_origin, (mon.x, mon.y)):
            normalize(self.app.monitors)
        self._fit(self.get_width(), self.get_height())
        self.set_cursor(Gdk.Cursor.new_from_name("grab", None))
        self.app.on_geometry_changed()

    def _snap(self, mon: Monitor, nx: float, ny: float):
        """Pull edges and centres onto neighbouring monitors' edges."""
        tol = SNAP_PX / max(self.zoom, 1e-6)
        w, h = mon.logical
        others = [m for m in self.app.monitors if m is not mon and m.enabled]

        best_dx = best_dy = None
        guides: list[tuple[str, float]] = []

        cand_x = [0.0]
        cand_y = [0.0]
        for other in others:
            ox, oy, ow, oh = other.rect
            cand_x += [ox, ox + ow, ox + ow / 2]
            cand_y += [oy, oy + oh, oy + oh / 2]

        for mine in (nx, nx + w, nx + w / 2):
            for target in cand_x:
                delta = target - mine
                if abs(delta) <= tol and (best_dx is None or abs(delta) < abs(best_dx)):
                    best_dx = delta
        for mine in (ny, ny + h, ny + h / 2):
            for target in cand_y:
                delta = target - mine
                if abs(delta) <= tol and (best_dy is None or abs(delta) < abs(best_dy)):
                    best_dy = delta

        fx = nx + (best_dx or 0.0)
        fy = ny + (best_dy or 0.0)
        if best_dx is not None:
            for edge in (fx, fx + w, fx + w / 2):
                if any(abs(edge - c) < 0.5 for c in cand_x):
                    guides.append(("v", edge))
        if best_dy is not None:
            for edge in (fy, fy + h, fy + h / 2):
                if any(abs(edge - c) < 0.5 for c in cand_y):
                    guides.append(("h", edge))
        return int(round(fx)), int(round(fy)), guides

    # -- painting --------------------------------------------------------

    def _draw(self, _area, cr, width, height) -> None:
        pal = self.pal
        self._view(width, height)

        cr.set_source_rgba(*pal.darker_background, 1.0)
        cr.paint()

        # Faint backdrop grid, one line per 500 desktop px.
        step = 500
        cr.set_line_width(1.0)
        cr.set_source_rgba(*pal.muted, 0.25)
        left, top = self.to_desktop(0, 0)
        right, bottom = self.to_desktop(width, height)
        gx = math.floor(left / step) * step
        while gx <= right:
            wx = round(self.to_widget(gx, 0)[0]) + 0.5
            cr.move_to(wx, 0); cr.line_to(wx, height)
            gx += step
        gy = math.floor(top / step) * step
        while gy <= bottom:
            wy = round(self.to_widget(0, gy)[1]) + 0.5
            cr.move_to(0, wy); cr.line_to(width, wy)
            gy += step
        cr.stroke()

        for mon in self.app.monitors:
            self._draw_monitor(cr, mon)

        # Snap guides on top.
        cr.set_line_width(1.0)
        cr.set_source_rgba(*pal.yellow, 0.9)
        cr.set_dash([4.0, 4.0])
        for kind, value in self.guides:
            if kind == "v":
                wx = round(self.to_widget(value, 0)[0]) + 0.5
                cr.move_to(wx, 0); cr.line_to(wx, height)
            else:
                wy = round(self.to_widget(0, value)[1]) + 0.5
                cr.move_to(0, wy); cr.line_to(width, wy)
        cr.stroke()
        cr.set_dash([])

    def _draw_monitor(self, cr, mon: Monitor) -> None:
        pal = self.pal
        mx, my, mw, mh = mon.rect
        x, y = self.to_widget(mx, my)
        w, h = mw * self.zoom, mh * self.zoom
        selected = mon is self.app.selected
        inset = 3
        x, y, w, h = x + inset, y + inset, max(w - inset * 2, 8), max(h - inset * 2, 8)

        if not mon.enabled:
            cr.set_source_rgba(*pal.dark_background, 0.75)
            rounded_rect(cr, x, y, w, h, 8)
            cr.fill_preserve()
            cr.set_source_rgba(*pal.muted, 0.9)
            cr.set_line_width(2)
            cr.set_dash([6.0, 5.0])
            cr.stroke()
            cr.set_dash([])
            text_at(cr, mon.name, x + w / 2, y + h / 2 - 8, 11,
                    pal.dark_foreground, 1.0, bold=True)
            text_at(cr, "off", x + w / 2, y + h / 2 + 10, 10, pal.dark_foreground, 1.0)
            return

        cr.set_source_rgba(*pal.lighter_background, 1.0)
        rounded_rect(cr, x, y, w, h, 8)
        cr.fill_preserve()
        cr.set_source_rgba(*(pal.accent if selected else pal.muted),
                           1.0 if selected else 0.9)
        cr.set_line_width(3 if selected else 1.5)
        cr.stroke()

        # Bezel-ish inner frame so portrait vs landscape reads at a glance.
        cr.set_source_rgba(*pal.darker_background, 0.55)
        rounded_rect(cr, x + 6, y + 6, max(w - 12, 4), max(h - 12, 4), 4)
        cr.fill()

        cx, cy = x + w / 2, y + h / 2
        badge = min(28.0, max(16.0, min(w, h) * 0.28))
        cr.set_source_rgba(*pal.accent, 1.0 if selected else 0.7)
        cr.arc(cx, cy - badge * 0.9, badge / 2, 0, 2 * math.pi)
        cr.fill()
        text_at(cr, str(mon.index), cx, cy - badge * 0.9, int(badge * 0.5),
                pal.darker_background if pal.dark else pal.background, 1.0, bold=True)

        if h > 64:
            text_at(cr, mon.name, cx, cy + 4, 11, pal.bright_foreground, 1.0, bold=True)
        if h > 88:
            lw_, lh_ = mon.logical
            text_at(cr, f"{lw_}×{lh_}", cx, cy + 22, 9, pal.foreground, 0.85, mono=True)
        if h > 110 and mon.transform:
            text_at(cr, TRANSFORMS[mon.transform][1], cx, cy + 38, 9, pal.yellow, 0.95)
        if h > 128:
            text_at(cr, f"{mx},{my}", cx, cy + 54, 8, pal.dark_foreground, 1.0, mono=True)


# --------------------------------------------------------------------------
# Writing monitors.lua
# --------------------------------------------------------------------------

BLOCK_BEGIN = "-- >>> monitor-align: generated block, edits here are overwritten"
BLOCK_END = "-- <<< monitor-align"


def lua_comment_text(value: str, limit: int = 512) -> str:
    """Make external text inert and single-line inside a generated Lua comment."""
    cleaned = []
    for char in str(value):
        if char in ("\r", "\n", "\u2028", "\u2029") or unicodedata.category(char).startswith("C"):
            cleaned.append(" ")
        else:
            cleaned.append(char)
    text = "".join(cleaned).replace(BLOCK_BEGIN, "[generated block begin]")
    text = text.replace(BLOCK_END, "[generated block end]")
    return text[:limit]


def render_block(monitors: list[Monitor]) -> str:
    stamp = time.strftime("%Y-%m-%d %H:%M")
    lines = [BLOCK_BEGIN, f"-- written {stamp}"]
    for mon in monitors:
        lines.append(f"-- {mon.index}. {lua_comment_text(mon.description)}")
        lines.append(mon.lua())
    lines.append(BLOCK_END)
    return "\n".join(lines)


def save_lua(monitors: list[Monitor], allow_empty: bool = False) -> tuple[bool, str]:
    # An empty block drops every hl.monitor rule; only write one on request.
    if not monitors and not allow_empty:
        return False, "Refusing to save: no monitors loaded, monitors.lua left unchanged"
    try:
        with open(MONITORS_LUA, "r") as handle:
            original = handle.read()
    except FileNotFoundError:
        original = ""
    except OSError as exc:
        return False, str(exc)

    if BLOCK_BEGIN in original and BLOCK_END in original:
        # Replace the block in place so lines after it stay after it.
        head, _, rest = original.partition(BLOCK_BEGIN)
        _, _, tail = rest.partition(BLOCK_END)
        new = head + render_block(monitors) + tail
        if not new.endswith("\n"):
            new += "\n"
    else:
        body = original.rstrip("\n")
        new = (body + "\n\n" if body else "") + render_block(monitors) + "\n"

    # Errors Hyprland already had are not ours to fail on.
    before = config_errors()

    backup = ""
    try:
        if os.path.exists(MONITORS_LUA):
            backup = unused_backup_path()
            shutil.copy2(MONITORS_LUA, backup)
        os.makedirs(os.path.dirname(MONITORS_LUA), exist_ok=True)
        write_atomic(MONITORS_LUA, new)
    except OSError as exc:
        note = f" (original kept; backup: {os.path.basename(backup)})" if backup else ""
        return False, f"{exc}{note}"

    hyprctl("reload")
    # The stock catch-all rule uses position = "auto", so a reload can shuffle
    # the desk before our block is honoured. Re-assert the explicit geometry.
    ok, message = apply_monitors(monitors)
    problem = "" if ok else f"Could not apply after reload: {message[:160]}"
    if not problem:
        new_errors = sorted(config_errors() - before)
        if new_errors:
            problem = new_errors[0][:160]
    if problem:
        return False, problem + restore_backup(backup)
    note = f" (backup: {os.path.basename(backup)})" if backup else ""
    return True, f"Saved to monitors.lua{note}"


def unused_backup_path() -> str:
    """A backup name no earlier save has taken, so none is ever overwritten."""
    stamp = time.time_ns()
    backup = f"{MONITORS_LUA}.bak.{stamp}"
    count = 0
    while os.path.exists(backup):
        count += 1
        backup = f"{MONITORS_LUA}.bak.{stamp}.{count}"
    return backup


def config_errors() -> set[str]:
    text = hyprctl("configerrors")
    if not text or "no errors" in text.lower():
        return set()
    return {line.strip() for line in text.splitlines() if line.strip()}


def write_atomic(path: str, text: str) -> None:
    """Replace `path` in one step so a failed write never truncates it."""
    tmp = f"{path}.tmp.{os.getpid()}"
    try:
        with open(tmp, "w") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        if os.path.exists(path):
            shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def block_monitor_lines(text: str) -> list[str]:
    """The hl.monitor lines of a generated block, or [] when there is none."""
    if BLOCK_BEGIN not in text or BLOCK_END not in text:
        return []
    _, _, rest = text.partition(BLOCK_BEGIN)
    block, _, _ = rest.partition(BLOCK_END)
    return [line.strip() for line in block.splitlines()
            if line.strip().startswith("hl.monitor(")]


def restore_backup(backup: str) -> str:
    """Put the pre-save monitors.lua back after a failed save; describe it."""
    previous = ""
    try:
        if backup:
            with open(backup, "r") as handle:
                previous = handle.read()
            write_atomic(MONITORS_LUA, previous)
        else:
            os.unlink(MONITORS_LUA)
    except OSError as exc:
        where = f"; restore it from {os.path.basename(backup)}" if backup else ""
        return f" — could not roll back monitors.lua ({exc}){where}"
    hyprctl("reload")
    if not backup:
        return " — new monitors.lua removed"
    note = f" — monitors.lua restored from {os.path.basename(backup)}"
    # Same reason as the save path: reload alone can leave the catch-all
    # auto layout up, so re-assert the restored file's explicit geometry.
    ok, message = hyprctl_eval("\n".join(block_monitor_lines(previous)))
    if not ok:
        note += f"; could not re-apply its layout: {message[:160]}"
    return note


